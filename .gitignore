# Root repository policy:
# Ignore everything by default, then explicitly allow only the two codebases
# that should be uploaded: SuperMew RAG and xiaozhi server/manager source code.

/*

!.gitignore
!README.md
!THIRD_PARTY_NOTICES.md
!start_museum_rag.ps1
!start_museum_rag.cmd
!UPSTREAM_MANIFEST.yaml
!UPSTREAM_SYNC_POLICY.md

# Development records are kept together instead of cluttering the project root.
!/docs/
!/docs/development/
!/docs/development/**
!/docs/screenshots/
!/docs/screenshots/*.png

# Keep the two product modules (renamed from their upstream project folders).
!/museum-rag/
!/museum-rag/**

!/zhibo-guide-platform/
/zhibo-guide-platform/*
!/zhibo-guide-platform/main/
!/zhibo-guide-platform/main/README.md
!/zhibo-guide-platform/main/README_en.md
!/zhibo-guide-platform/main/manager-api/
!/zhibo-guide-platform/main/manager-api/**
!/zhibo-guide-platform/main/manager-web/
!/zhibo-guide-platform/main/manager-web/**
!/zhibo-guide-platform/main/xiaozhi-server/
!/zhibo-guide-platform/main/xiaozhi-server/**
!/zhibo-guide-platform/.gitignore

# Not part of this upload scope
/zhibo-guide-platform/main/digital-human/
/zhibo-guide-platform/main/manager-mobile/

# Explicitly ignore non-code / local-only top-level folders
/doc/
/rag_test/
/scripts/
/yingjian/
/tmp_docx_render/
/.agents/
/.codex/
/.tools/

# Secrets and local runtime config
**/.env
**/.env.*
!**/.env.example
!**/.env.template
**/application-local.yml
**/application-dev.yml
**/main/xiaozhi-server/config.yaml
**/.config.yaml
**/.secrets.yaml
**/.private_config.yaml
**/data/.config.yaml

# Python virtual environments and caches
**/.venv/
**/venv/
**/env/
**/.agent-venv/
**/.agent-venv-*/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.cache/

# Node dependencies and build output
**/node_modules/
**/dist/
**/.vite/
**/.webpack_cache/
**/coverage/

# Java / Maven / Gradle build output
**/target/
**/.gradle/
**/build/

# Downloaded model files and large runtime assets
**/models/
**/volumes/
**/asr-models/
**/wakeword_runtime/models/
**/public/generator/assets/
**/public/generator/static/
**/sherpa-onnx*/
**/*SenseVoiceSmall*/
**/*.pt
**/*.pth
**/*.onnx
**/*.bin
**/*.safetensors
**/*.gguf
**/*.tar
**/*.tar.gz
**/*.tar.bz2
**/*.zip

# User uploads, generated files, logs, databases
**/uploadfile/
**/uploads/
**/tmp/
**/logs/
**/*.log
**/*.pid
**/*.sqlite
**/*.sqlite3
**/*.db

# Documents and test materials inside allowed code folders
**/*.doc
**/*.docx
**/*.pdf
**/*.xls
**/*.xlsx
**/*.ppt
**/*.pptx
**/presentation.html
**/project_visualization.html

# IDE / OS files
**/.idea/
**/.vscode/
**/.cursor/
**/.DS_Store
**/Thumbs.db
